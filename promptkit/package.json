{
  "name": "promptkit",
  "version": "1.0.0",
  "description": "A lightweight, type-safe, and zero-dependency TypeScript prompt builder for LLMs (OpenAI, Claude, etc.)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptkit/promptkit.git"
  },
  "keywords": [
    "prompt",
    "prompt-builder",
    "llm",
    "ai",
    "template",
    "chatgpt",
    "openai",
    "claude",
    "typescript",
    "zero-dependency",
    "prompt-engineering"
  ],
  "author": "promptkit",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/promptkit/promptkit/issues"
  },
  "homepage": "https://github.com/promptkit/promptkit#readme",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
